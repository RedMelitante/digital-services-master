# Public site URL used for canonical links and the sitemap.
SITE_URL=https://digitalservicesmaster.com

# Google Apps Script web app URL (ends in /exec) that emails the
# "Book a Free Clinic Growth Audit" form. Deploy it from apps-script/audit-form/.
