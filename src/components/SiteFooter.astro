---
/** SiteFooter (design component). */
interface Props {
  /** Target of the "Book an Audit" link (the Contact page links to its own form). */
  ctaHref?: string;
}
const { ctaHref = '/contact/' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="foot" style="background: var(--navy); color: #B9C3E3; font-size: 15px">
<div style="max-width: 1240px; margin: 0 auto; padding: 80px clamp(16px, 4vw, 32px) 32px; display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-wrap: wrap; gap: 48px">
<div style="flex: 1 1 300px; display: flex; flex-direction: column; gap: 18px; min-width: 0; max-width: 400px">
<a href="/" aria-label="Digital Services Master home" style="display: flex; align-items: center; gap: 12px"><img src="/images/dsm-light.png" alt="Dsm" style="display: block; height: 38px; width: auto" decoding="async"><span style="font-size: 12px; font-weight: 600; line-height: 1.25; color: #B9C3E3; border-left: 1px solid rgba(255,255,255,0.2); padding-left: 12px">Digital<br>Services Master</span></a>
<p style="line-height: 1.7">Web development and digital marketing for aesthetic and dental clinics in the Philippines and Australia. From Garage to the Top: guided by values, driven by results.</p>
<div style="display: flex; gap: 12px">
<a href="https://www.facebook.com/share/1A71p5ifma/?mibextid=wwXIfr" target="_blank" rel="noopener" aria-label="Facebook" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15Z"></path></svg></a>
<a href="https://www.instagram.com/digitalservicesmaster?psln=OXo4MHlrems4cnhm" target="_blank" rel="noopener" aria-label="Instagram" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg></a>
</div>
</div>
<div style="flex: 2 1 520px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 32px">
<nav aria-label="Company" style="display: flex; flex-direction: column; gap: 12px"><p style="font-weight: 700; color: #fff; margin-bottom: 4px">Company</p><a href="/about/">About Us</a><a href="/pricing/">Pricing</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a><a href={ctaHref}>Book an Audit</a></nav>
<nav aria-label="Services" style="display: flex; flex-direction: column; gap: 12px"><p style="font-weight: 700; color: #fff; margin-bottom: 4px">Services</p><a href="/services/web-development/">Web Development</a><a href="/services/seo/">SEO</a><a href="/services/paid-advertising/">Paid Advertising</a></nav>
<nav aria-label="Portfolio" style="display: flex; flex-direction: column; gap: 12px"><p style="font-weight: 700; color: #fff; margin-bottom: 4px">Portfolio</p><a href="/portfolio/aesthetic-clinic-websites/">Aesthetic Clinics</a><a href="/portfolio/dental-clinic-websites/">Dental Clinics</a><a href="/portfolio/custom-websites/">Business Websites</a><a href="/portfolio/ecommerce-websites/">E-commerce</a><a href="/case-studies/">Case Studies</a></nav>
<nav aria-label="Resources" style="display: flex; flex-direction: column; gap: 12px"><p style="font-weight: 700; color: #fff; margin-bottom: 4px">Resources</p><a href="/blog/">Blog</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-service/">Terms of Service</a></nav>
</div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 16px 40px; padding: 24px 0; border-top: 1px solid rgba(255,255,255,0.12); border-bottom: 1px solid rgba(255,255,255,0.12)">
<span style="display: inline-flex; align-items: center; gap: 10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><a href="mailto:digitalservicesmaster@gmail.com" style="color: inherit">digitalservicesmaster@gmail.com</a></span>
<span style="display: inline-flex; align-items: center; gap: 10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg><a href="tel:+639176777717" style="color: inherit">0917 677 7717</a></span>
<span style="display: inline-flex; align-items: center; gap: 10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>Philippines &amp; Australia</span>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 14px">
<span>© {year} Digital Services Master. All rights reserved.</span>
<span style="display: flex; gap: 24px"><a href="/privacy-policy/">Privacy</a><a href="/terms-of-service/">Terms</a></span>
</div>
</div>
</footer>