---
import SiteHeader, { type NavKey } from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { LogicName } from '../scripts/logic';
import { PAGE_SEO } from '../data/seo';
import { buildSchema } from '../lib/schema';
import '../styles/global.css';

interface Props {
  /** Page title. Ignored when src/data/seo.ts has a title for this URL. */
  title?: string;
  /** Meta description. Ignored when src/data/seo.ts has one for this URL. */
  description?: string;
  /** Header item to highlight. */
  nav?: NavKey | null;
  /** Target of header/footer audit links. */
  ctaHref?: string;
  /** Extra CSS custom properties for the page wrapper (e.g. project colours). */
  vars?: string;
  /** Page state logic (see src/scripts/logic.ts). */
  logic?: LogicName;
  /** Open Graph type. */
  type?: 'website' | 'article';
  /** Social share image (path or absolute URL), used when src/data/seo.ts has none. */
  image?: string;
  /** Render the shared header and footer (the homepage renders its own). */
  chrome?: boolean;
  noindex?: boolean;
}

const {
  title: titleProp,
  description: descriptionProp = 'Web development, SEO and paid advertising for aesthetic and dental clinics in the Philippines and Australia.',
  nav = null,
  ctaHref,
  vars,
  logic = 'base',
  type: typeProp = 'website',
  image: imageProp = '/images/og-default.jpg',
  chrome = true,
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const seo = PAGE_SEO[path] ?? {};
const title = seo.title ?? titleProp;
if (!title) throw new Error(`No title for ${path}: pass one to BaseLayout or add it to src/data/seo.ts`);
const description = seo.description ?? descriptionProp;
const ogTitle = seo.ogTitle ?? title;
const ogDescription = seo.ogDescription ?? description;
const ogType = seo.ogType ?? (seo.article ? 'article' : typeProp);
const canonical = new URL(path, Astro.site);
const ogImage = seo.image
  ? { url: new URL(seo.image.src, Astro.site).href, width: seo.image.width, height: seo.image.height, type: seo.image.type }
  : { url: new URL(imageProp, Astro.site).href, width: imageProp === '/images/og-default.jpg' ? 1200 : undefined, height: imageProp === '/images/og-default.jpg' ? 630 : undefined, type: undefined };
const schema = noindex ? [] : buildSchema({ site: Astro.site!, path, title, description, seo, image: ogImage });
const ROBOTS = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? 'noindex, follow' : ROBOTS}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#0D1838">
<link rel="icon" href="/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap-index.xml">

<meta property="og:locale" content="en_US">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Digital Services Master">
{seo.article && <meta property="article:published_time" content={seo.article.datePublished}>}
{seo.dateModified && <meta property="article:modified_time" content={seo.dateModified}>}
<meta property="og:image" content={ogImage.url}>
{ogImage.width && <meta property="og:image:width" content={String(ogImage.width)}>}
{ogImage.height && <meta property="og:image:height" content={String(ogImage.height)}>}
{ogImage.type && <meta property="og:image:type" content={ogImage.type}>}
{seo.article && <meta name="author" content={seo.article.author}>}
<meta name="twitter:card" content="summary_large_image">
{seo.twitterLabels?.map(([label, data], i) => (
  <Fragment>
    <meta name={`twitter:label${i + 1}`} content={label}>
    <meta name={`twitter:data${i + 1}`} content={data}>
  </Fragment>
))}
{schema.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, "\\u003c")} />)}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body data-logic={logic}>
<a class="skip-link" href="#main">Skip to content</a>
<div class="site" style={vars}>
{chrome && <SiteHeader nav={nav} ctaHref={ctaHref} />}
<main id="main">
<slot />
</main>
{chrome && <SiteFooter ctaHref={ctaHref} />}
</div>
<script>
  import { mount } from '../scripts/bindings';
  mount(document.body.dataset.logic ?? 'base');
</script>
</body>
</html>
