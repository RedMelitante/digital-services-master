---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ssrValues } from '../scripts/logic';
import '../styles/pages/portfolio.css';

const v = ssrValues('portfolio');
---
<BaseLayout title={'Portfolio — Digital Services Master'} description={'A selection of websites we\'ve designed and built for aesthetic clinics, dental clinics and growing businesses in the Philippines and Australia.'} nav="portfolio" logic="portfolio">
<!-- ============ PAGE HERO (PageHero, centred) ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div aria-hidden="true" style="position: absolute; width: 140px; height: 140px; border-radius: 50%; background: #C9F4F7; left: 6%; bottom: -60px"></div>
<div style="position: relative; max-width: 860px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Portfolio</span></nav>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Websites that help clinics get <span style="color: var(--blue)">booked</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 620px; text-wrap: pretty">A selection of websites we've designed and built for aesthetic clinics, dental clinics and growing businesses in the Philippines and Australia.</p>
</div>
</section>

<!-- ============ FILTERS + GRID (FilterTabs + PortfolioCard) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: 48px clamp(16px, 4vw, 32px) clamp(72px, 9vw, 112px); display: flex; flex-direction: column; gap: 40px">
<div role="group" aria-label="Filter projects" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; padding: 6px; background: var(--tint2); border: 1px solid var(--line); border-radius: 999px; align-self: center">
<button data-b class="tab" aria-pressed={v.pAll ? 'true' : 'false'} data-b-aria-pressed="{{pAll}}" data-b-click="setAll" style={`background: ${v.bgAll}; color: ${v.fgAll}`} data-b-style="background: {{bgAll}}; color: {{fgAll}}">All work <span data-b class="count" style={`background: ${v.cbAll}`} data-b-style="background: {{cbAll}}">10</span></button>
<button data-b class="tab" aria-pressed={v.pA ? 'true' : 'false'} data-b-aria-pressed="{{pA}}" data-b-click="setA" style={`background: ${v.bgA}; color: ${v.fgA}`} data-b-style="background: {{bgA}}; color: {{fgA}}">Aesthetic Clinics <span data-b class="count" style={`background: ${v.cbA}`} data-b-style="background: {{cbA}}">3</span></button>
<button data-b class="tab" aria-pressed={v.pD ? 'true' : 'false'} data-b-aria-pressed="{{pD}}" data-b-click="setD" style={`background: ${v.bgD}; color: ${v.fgD}`} data-b-style="background: {{bgD}}; color: {{fgD}}">Dental Clinics <span data-b class="count" style={`background: ${v.cbD}`} data-b-style="background: {{cbD}}">2</span></button>
<button data-b class="tab" aria-pressed={v.pC ? 'true' : 'false'} data-b-aria-pressed="{{pC}}" data-b-click="setC" style={`background: ${v.bgC}; color: ${v.fgC}`} data-b-style="background: {{bgC}}; color: {{fgC}}">Custom Websites <span data-b class="count" style={`background: ${v.cbC}`} data-b-style="background: {{cbC}}">2</span></button>
<button data-b class="tab" aria-pressed={v.pE ? 'true' : 'false'} data-b-aria-pressed="{{pE}}" data-b-click="setE" style={`background: ${v.bgE}; color: ${v.fgE}`} data-b-style="background: {{bgE}}; color: {{fgE}}">E-commerce <span data-b class="count" style={`background: ${v.cbE}`} data-b-style="background: {{cbE}}">3</span></button>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 24px">


<a data-b data-b-if="showA" hidden={!v.showA} class="card" href="/case-studies/coastal-luxe-aesthetics/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit">
<div style="position: relative; aspect-ratio: 4 / 3; background: #F3ECE4; padding: 32px 32px 0; display: flex; align-items: flex-end">
<span style="position: absolute; top: 16px; left: 16px; font-size: 12px; font-weight: 700; color: #fff; background: var(--blue); border-radius: 999px; padding: 4px 12px">Case study</span>
<div style="width: 84%; background: #fff; border-radius: 12px 12px 0 0; overflow: hidden; box-shadow: 0 20px 40px -24px rgba(60,40,20,0.5)">
<div style="display: flex; gap: 5px; padding: 8px 10px; background: #F7F2EC"><span style="width: 7px; height: 7px; border-radius: 50%; background: #E3D6C8"></span><span style="width: 7px; height: 7px; border-radius: 50%; background: #E3D6C8"></span><span style="width: 7px; height: 7px; border-radius: 50%; background: #E3D6C8"></span></div>
<img src="/images/cla-desk.webp" alt="Coastal Luxe Aesthetics website" style="display: block; width: 100%; height: auto" loading="lazy" decoding="async">
</div>
<div style="position: absolute; right: 6%; bottom: 0; width: 24%; background: #1A2036; border-radius: 16px 16px 0 0; padding: 5px 5px 0"><img src="/images/cla-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 9 / 14; object-fit: cover; border-radius: 12px 12px 0 0" loading="lazy" decoding="async"></div>
</div>
<div style="padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 8px">
<span style="align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #8A4B36; background: #F8ECE7; border-radius: 999px; padding: 4px 12px">Aesthetic Clinic</span>
<h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Coastal Luxe Aesthetics</h3>
<span class="tlink">Read case study <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</div>
</a>



