---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ssrValues } from '../scripts/logic';
import { FAQ_GROUPS } from '../data/faq';
import '../styles/pages/faq.css';

const v = ssrValues('faq');
const tabs = [{ key: 'All', label: 'All questions' }, ...FAQ_GROUPS.map((g) => ({ key: g.id, label: g.name }))];
---
<BaseLayout logic="faq">
<!-- ============ FAQ HERO ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div style="position: relative; max-width: 820px; margin: 0 auto; padding: clamp(48px, 7vw, 80px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><span style="color: var(--ink)">FAQ</span></nav>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink)">Your questions, <span style="color: var(--blue)">answered</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 600px">Quick answers about our services, process and pricing. Can't find what you need? We're happy to talk it through.</p>
</div>
</section>

<!-- ============ FAQ GROUPS ============ -->
<section style="background: #fff">
<div style="max-width: 920px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 32px) clamp(72px, 9vw, 112px); display: flex; flex-direction: column; gap: 40px">
<div role="group" aria-label="Filter questions" style="align-self: center; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 6px; background: var(--tint2); border: 1px solid var(--line); border-radius: 28px">
{tabs.map((t) => <button data-b class="tab" aria-pressed={v[`tab_${t.key}_on`] ? 'true' : 'false'} data-b-aria-pressed={`{{tab_${t.key}_on}}`} data-b-click={`pick_${t.key}`} style={`background: ${v[`tab_${t.key}_bg`]}; color: ${v[`tab_${t.key}_fg`]}`} data-b-style={`background: {{tab_${t.key}_bg}}; color: {{tab_${t.key}_fg}}`}>{t.label}</button>)}
</div>
{FAQ_GROUPS.map((g) => (
<div data-b data-b-if={`show_${g.id}`} hidden={!v[`show_${g.id}`]} style="display: flex; flex-direction: column; gap: 14px">
<h2 style="font-size: 14px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">{g.name}</h2>
{g.items.map(([question, answer], i) => {
  const id = g.id + i;
  return (
<div data-b style={`border: 1px solid var(--line); border-radius: 20px; background: ${v[`bg_${id}`]}`} data-b-style={`border: 1px solid var(--line); border-radius: 20px; background: {{bg_${id}}}`}>
<button data-b class="faq-q" id={`faq-q-${id}`} aria-controls={`faq-a-${id}`} aria-expanded={v[`open_${id}`] ? 'true' : 'false'} data-b-aria-expanded={`{{open_${id}}}`} data-b-click={`toggle_${id}`}>{question}<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: ${v[`iconBg_${id}`]}; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v[`rot_${id}`]}; transition: transform .2s`} data-b-style={`width: 36px; height: 36px; border-radius: 50%; background: {{iconBg_${id}}}; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot_${id}}}; transition: transform .2s`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button>
<p data-b id={`faq-a-${id}`} role="region" aria-labelledby={`faq-q-${id}`} data-b-if={`open_${id}`} hidden={!v[`open_${id}`]} style="padding: 0 76px 24px 24px; font-size: 16px">{answer}</p>
</div>
  );
})}
</div>
))}

<div style="margin-top: 8px; padding: 32px; border-radius: 28px; background: var(--tint); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px">
<div style="display: flex; flex-direction: column; gap: 6px"><p style="font-size: 20px; font-weight: 800; color: var(--ink)">Still have questions?</p><p style="font-size: 16px">Send us a message and our team will get back to you.</p></div>
<a class="btn btn-ghost" href="/contact-website-development-services/">Get in Touch</a>
</div>
</div>
</section>

<!-- ============ CTA BAND ============ -->
<section style="background: #fff; padding: 0 clamp(16px, 4vw, 32px) clamp(72px, 9vw, 112px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Let's grow your clinic's bookings</h2><p style="color: #C9D3F2; font-size: 18px">Get a free Clinic Growth Audit: a clear look at your website, Google visibility and ads, with practical next steps.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact-website-development-services/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/contact-website-development-services/">Get in Touch</a></div>
</div>
</section>
</BaseLayout>
