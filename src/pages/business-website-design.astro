---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/portfolio-pages.css';
---
<BaseLayout nav="portfolio" logic="base">
<!-- ============ CATEGORY HERO ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div style="position: relative; max-width: 880px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><a href="/web-design-portfolio/" style="color: var(--muted)">Portfolio</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Business &amp; Service Websites</span></nav>
<p class="eb">Business &amp; Service Websites</p>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Smart web design for <span style="color: var(--blue)">businesses with purpose</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 640px; text-wrap: pretty">A well-designed website is essential for any business. We create professional, high-performing websites that build credibility, attract customers and drive conversions.</p>
</div>
</section>

<!-- ============ CATEGORY GRID ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 32px) 0; display: flex; flex-direction: column; gap: 40px">
<nav aria-label="Portfolio categories" style="align-self: center; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 6px; background: var(--tint2); border: 1px solid var(--line); border-radius: 28px"><a class="tab" href="/web-design-portfolio/">All work</a><a class="tab" href="/aesthetics-clinic-website-design/">Aesthetic Clinics</a><a class="tab" href="/dental-clinic-websites/">Dental Clinics</a><span class="tab" aria-current="page" style="background: #131A33; color: #fff">Business &amp; Service Websites</span><a class="tab" href="/e-commerce-websites/">E-commerce Websites</a></nav>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 24px"><a class="card" href="/ndis-provider-website-design-aplus-health-services/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/aplus-photo.webp" alt="Aplus Health Services" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #EEF0FA" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">NDIS Provider</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Aplus Health Services</h3></div></a><a class="card" href="/flooring-website-design-constantin-floors/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/con-photo.webp" alt="Constantin Floors" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #EFEBE6" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Flooring Installations</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Constantin Floors</h3></div></a><a class="card" href="/prefab-website-design-camco/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/camco-photo.webp" alt="CAMCO Prefabricated Structures" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #E7ECEF" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Prefab Structures</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">CAMCO Prefabricated Structures</h3></div></a><a class="card" href="/e-commerce-website-design-good-force/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/gf-desk.webp" alt="Good Force" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: contain; padding: 22px; box-sizing: border-box; background: #FBF3E4" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Supplier Website</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Good Force</h3></div></a><a class="card" href="/contact-website-development-services/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/karmel-photo.webp" alt="Karmel Contreras Interior Design" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F2EFEA" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Interior Design Studio</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Karmel Contreras Interior Design</h3></div></a><a class="card" href="/contact-website-development-services/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/sepe-photo.webp" alt="Southeast Presentation Events" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F3ECF6" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Events</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Southeast Presentation Events</h3></div></a></div>
</div>
</section>

<!-- ============ CTA BAND (CtaBand) ============ -->
<section style="background: #fff; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Let's build your next website</h2><p style="color: #C9D3F2; font-size: 18px">Start with a free Clinic Growth Audit of your current site, Google visibility and ads.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact-website-development-services/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/web-design-portfolio/">All Work</a></div>
</div>
</section>
</BaseLayout>
