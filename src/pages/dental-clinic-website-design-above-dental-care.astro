---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/project.css';
---
<BaseLayout nav="portfolio" vars="--pj: #E3F5F6; --pj-mid: #C8ECEE; --pj-deep: #0E6F78" logic="base">
<!-- ============ PROJECT HERO (ProjectHero) ============ -->
<section style="background: var(--pj); overflow: hidden">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) clamp(16px, 4vw, 32px) clamp(56px, 7vw, 88px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: clamp(40px, 5vw, 72px); align-items: center">
<div style="display: flex; flex-direction: column; gap: 22px; align-items: flex-start">
<nav aria-label="Breadcrumb" style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; font-weight: 600; color: #3E6E72"><a href="/" style="color: #3E6E72">Home</a><span aria-hidden="true">/</span><a href="/web-design-portfolio/" style="color: #3E6E72">Portfolio</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Above Dental Care</span></nav>
<span style="font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--pj-deep); background: #fff; border-radius: 999px; padding: 5px 14px">Project · Dental Clinic</span>
<h1 style="font-size: clamp(40px, 4.8vw, 62px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 800; color: var(--ink)">Above Dental Care</h1>
<p style="font-size: clamp(18px, 1.6vw, 21px); color: #2E4F52; max-width: 520px">A digital transformation for patient-centered dentistry.</p>
<dl style="margin: 6px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 16px 28px; width: 100%; font-size: 15px">
<div><dt style="color: #3E6E72; font-weight: 600">Location</dt><dd style="margin: 0; color: var(--ink); font-weight: 700">Cagayan de Oro City, Philippines</dd></div>
<div><dt style="color: #3E6E72; font-weight: 600">Platform</dt><dd style="margin: 0; color: var(--ink); font-weight: 700">WordPress</dd></div>
<div><dt style="color: #3E6E72; font-weight: 600">Services</dt><dd style="margin: 0; color: var(--ink); font-weight: 700">Website, online booking, SEO</dd></div>
<div><dt style="color: #3E6E72; font-weight: 600">Website</dt><dd style="margin: 0"><a href="https://abovedentalcare.com" target="_blank" rel="noopener" style="font-weight: 700; color: var(--pj-deep)">abovedentalcare.com ↗</a></dd></div>
</dl>
</div>
<div style="position: relative; min-height: 420px; display: flex; align-items: center; justify-content: center">
<div style="width: 92%; background: #1A2036; border-radius: 18px 18px 6px 6px; padding: 11px 11px 15px; box-shadow: 0 40px 70px -30px rgba(10,60,70,0.5)">
<img src="/images/above-desk.webp" alt="Above Dental Care website homepage" style="display: block; width: 100%; height: auto; border-radius: 6px" decoding="async">
</div>
<div style="position: absolute; right: 0; bottom: -4%; width: 34%; background: #fff; border-radius: 22px; padding: 6px; box-shadow: 0 30px 50px -20px rgba(13,24,56,0.45)"><img src="/images/above-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 16px" decoding="async"></div>
</div>
</div>
</section>

<!-- ============ RESULTS STRIP (ResultStats) ============ -->
<section style="background: #fff; border-bottom: 1px solid var(--line)">
<div style="max-width: 1240px; margin: 0 auto; padding: 48px clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px">
<div style="background: var(--tint2); border: 1px solid var(--line); border-radius: 24px; padding: 28px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">80%</p><p style="margin-top: 10px; font-size: 15px; font-weight: 600; color: var(--ink)">Increase in new patient inquiries</p></div>
<div style="background: var(--tint2); border: 1px solid var(--line); border-radius: 24px; padding: 28px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">#2</p><p style="margin-top: 10px; font-size: 15px; font-weight: 600; color: var(--ink)">On Google for “Dental Clinic in Cagayan de Oro”</p></div>
<div style="background: var(--tint2); border: 1px solid var(--line); border-radius: 24px; padding: 28px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">Online</p><p style="margin-top: 10px; font-size: 15px; font-weight: 600; color: var(--ink)">Booking system built into the site</p></div>
</div>
</section>

<!-- ============ CHALLENGE / SOLUTION (ProjectStory) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 104px) clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 24px">
<article style="border: 1px solid var(--line); border-radius: 28px; padding: clamp(28px, 3.5vw, 44px); display: flex; flex-direction: column; gap: 14px">
<p class="eb">The challenge</p>
<h2 style="font-size: 26px; line-height: 1.25; font-weight: 800; color: var(--ink); letter-spacing: -0.02em">Modernise the clinic's digital presence</h2>
<p>Above Dental Care wanted to modernise its digital presence and improve the patient experience. The clinic faced challenges in managing patient inquiries, reducing appointment no-shows and boosting its online visibility to attract more patients.</p>
</article>
<article style="background: var(--navy); border-radius: 28px; padding: clamp(28px, 3.5vw, 44px); display: flex; flex-direction: column; gap: 14px; color: #fff">
<p class="eb" style="color: #8BE9F0">What we built</p>
<h2 style="font-size: 26px; line-height: 1.25; font-weight: 800; color: #fff; letter-spacing: -0.02em">A booking-ready, SEO-optimised clinic website</h2>
<p style="color: #C9D3F2">We designed and built a WordPress website with an integrated online booking system and SEO-optimised content. The clean, user-friendly interface lets patients easily schedule appointments and find dental care information.</p>
<ul style="list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 16px; color: #EEF2FF; font-weight: 500">
<li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Integrated online booking</li>
<li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Targeted local SEO</li>
<li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Easy access to services, contact details and patient education</li>
</ul>
</article>
</div>
</section>

<!-- ============ SCREENS (ScreenGallery) ============ -->
<section style="background: var(--pj)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 96px) clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 24px">
<figure style="margin: 0; display: flex; flex-direction: column; gap: 12px"><img src="/images/above-desk.webp" alt="Above Dental Care" style="display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: contain; border-radius: 24px; background: #fff" loading="lazy" decoding="async"><figcaption style="font-size: 15px; font-weight: 600; color: var(--ink)">Homepage</figcaption></figure>
<figure style="margin: 0; display: flex; flex-direction: column; gap: 12px"><img src="/images/above-extra.webp" alt="Above Dental Care" style="display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: contain; border-radius: 24px; background: #fff" loading="lazy" decoding="async"><figcaption style="font-size: 15px; font-weight: 600; color: var(--ink)">Found on Google</figcaption></figure>
</div>
</section>

<!-- ============ MORE PROJECTS ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 96px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px"><h2 style="font-size: clamp(28px, 2.8vw, 38px); line-height: 1.2; letter-spacing: -0.02em; font-weight: 800; color: var(--ink)">More projects</h2><a class="btn btn-ghost" href="/web-design-portfolio/">View Our Work</a></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
<a class="card" href="/cosmetic-clinic-website-design-cla/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/cla-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F3ECE4" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Aesthetic Clinic · Case study</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Coastal Luxe Aesthetics</h3></div></a>
<a class="card" href="/dental-care-website-design-sia-tankiko/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/sia-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #E6F4EC" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Dental Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Sia-Tankiko Dental Clinic</h3></div></a>
<a class="card" href="/dentistry-website-development-millennium/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/mil-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #E8F1FB" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Dental Center</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Millennium Smiles Dental Center</h3></div></a>
</div>
</div>
</section>

<!-- ============ CTA BAND ============ -->
<section style="background: #fff; padding: 0 clamp(16px, 4vw, 32px) clamp(72px, 9vw, 112px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Want results like these for your clinic?</h2><p style="color: #C9D3F2; font-size: 18px">Book a free Clinic Growth Audit and we'll show you where your next bookings are coming from.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact-website-development-services/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/web-design-portfolio/">View Our Work</a></div>
</div>
</section>
</BaseLayout>
