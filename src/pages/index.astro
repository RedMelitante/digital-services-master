---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ssrValues } from '../scripts/logic';
import '../styles/pages/main-service-webdev.css';
import '../styles/pages/home.css';

const v = ssrValues('accordion4');
---
<BaseLayout title={'Home — Digital Services Master'} description={'Attract more clients, build trust and grow. Your website, Google visibility and ads working together to bring in qualified calls and consultation requests…'} nav="home" logic="accordion4" chrome={false}>
<!-- ================= DESKTOP & TABLET (Main.dc.html) ================= -->
<div class="home-d">
<SiteHeader nav="home" />
<!-- ============ HERO (component: HeroSplit + DeviceMockup) ============ -->
<section style="background: var(--tint2); overflow: hidden">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 96px) clamp(16px, 4vw, 32px) clamp(64px, 8vw, 112px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); gap: clamp(48px, 5vw, 72px); align-items: center">
<div style="display: flex; flex-direction: column; gap: 28px; align-items: flex-start">
<span style="display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px 8px 10px; font-size: 14px; font-weight: 600; color: var(--ink)"><span style="width: 22px; height: 22px; border-radius: 50%; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></span>For aesthetic &amp; dental clinics in the Philippines and Australia</span>
<h1 style="font-size: clamp(38px, 4.6vw, 62px); line-height: 1.07; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Digital Marketing for Aesthetic and Dental Clinics That Want <span style="color: var(--blue)">More Bookings</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 540px; text-wrap: pretty">Attract more clients, build trust and grow. Your website, Google visibility and ads working together to bring in qualified calls and consultation requests, not just traffic.</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a class="btn btn-cta" href="/contact/">Book a Free Clinic Growth Audit <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
<a class="btn btn-ghost" href="/portfolio/">View Our Work</a>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 10px 28px; font-size: 15px; font-weight: 600; color: var(--ink)">
<span style="display: inline-flex; align-items: center; gap: 8px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>10+ years of experience</span>
<span style="display: inline-flex; align-items: center; gap: 8px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>Web, SEO &amp; ads under one roof</span>
</div>
</div>

<!-- Hero visual: real client website (component: DeviceMockup) -->
<div style="position: relative; padding: 44px 0 56px">
<div aria-hidden="true" style="position: absolute; width: 84%; aspect-ratio: 1; border-radius: 50%; background: #DFE7FF; right: -6%; top: 50%; transform: translateY(-50%)"></div>
<!-- Laptop with a real client website -->
<div style="position: relative; width: 92%">
<div style="background: #1A2036; border-radius: 18px 18px 6px 6px; padding: 10px 10px 14px; box-shadow: 0 40px 70px -30px rgba(13,24,56,0.45)">
<div style="border-radius: 6px; overflow: hidden; background: #fff">
<div style="display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #F1F3F8"><span style="width: 8px; height: 8px; border-radius: 50%; background: #FF8A80"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #FFD166"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #7BD88F"></span><span style="margin-left: 8px; flex: 1; max-width: 260px; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12px; color: #646B88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">coastalluxeaesthetics.com.au</span></div>
<img loading="lazy" src="/images/cla-desk.webp" alt="Coastal Luxe Aesthetics website, built by Digital Services Master" style="display: block; width: 100%; height: auto" decoding="async">
</div>
</div>
<div style="height: 14px; margin: 0 -6%; background: #CDD3E2; border-radius: 0 0 18px 18px; box-shadow: inset 0 3px 0 #E6EAF3"></div>
</div>
<!-- Phone -->
<div style="position: absolute; right: 0; bottom: 16px; width: 26%; background: #1A2036; border-radius: 28px; padding: 7px; box-shadow: 0 30px 50px -20px rgba(13,24,56,0.5)">
<img loading="lazy" src="/images/cla-photo.webp" alt="Coastal Luxe Aesthetics clinic" style="display: block; width: 100%; aspect-ratio: 9 / 17; object-fit: cover; border-radius: 22px" decoding="async">
</div>
<div style="position: absolute; top: 0; left: -4%; z-index: 2; background: #fff; border-radius: 16px; padding: 12px 16px 12px 12px; display: flex; gap: 12px; align-items: center; box-shadow: 0 24px 40px -20px rgba(13,24,56,0.35); border: 1px solid var(--line)">
<span style="width: 42px; height: 42px; border-radius: 12px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path><path d="m9 15 2 2 4-4"></path></svg></span>
<span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-size: 14px; font-weight: 700; color: var(--ink)">New consultation request</span><span style="font-size: 13px; color: var(--muted)">Anti-wrinkle · via website</span></span>
</div>
<div style="position: absolute; bottom: 0; left: 6%; z-index: 2; background: #fff; border-radius: 16px; padding: 12px 16px 12px 12px; display: flex; gap: 12px; align-items: center; box-shadow: 0 24px 40px -20px rgba(13,24,56,0.35); border: 1px solid var(--line)">
<span style="width: 42px; height: 42px; border-radius: 12px; background: #FFF1E3; color: #B35A00; display: flex; align-items: center; justify-content: center; flex: none"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></span>
<span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-size: 14px; font-weight: 700; color: var(--ink)">Found on Google</span><span style="font-size: 13px; color: var(--muted)">“cosmetic clinic near me”</span></span>
</div>
</div>
</div>
</section>

<!-- ============ LOGO STRIP (component: LogoStrip) ============ -->
<section aria-label="Clients" style="background: #fff; border-bottom: 1px solid var(--line)">
<div style="max-width: 1240px; margin: 0 auto; padding: 44px clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; gap: 24px">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted)">Clinics and brands that trust us</p>
<div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 28px"><img src="/images/lg-above.png" alt="Above Dental Care" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-sia.png" alt="Sia-Tankiko Dental Clinic" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-cla.png" alt="Coastal Luxe Aesthetics" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-aplus.png" alt="A+ Health Services" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-lamaison.png" alt="La Maison Beaute" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-venus.png" alt="Venus Medispa" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-constantin.png" alt="Constantin Floors" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-camco.png" alt="CAMCO Prefabricated Structures" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-goodforce.png" alt="Good Force" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"><img src="/images/lg-clasol.png" alt="CLA Solutions" style="display: block; height: 64px; width: auto; mix-blend-mode: multiply" loading="lazy" decoding="async"></div>
</div>
</section>

<!-- ============ WHY CLINICS HIRE US (component: OutcomeCards) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px; margin: 0 auto">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">Why clinics hire us</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink); text-wrap: balance">More bookings, not just more traffic</h2>
<p style="text-wrap: pretty">Traffic is easy to buy. Booked consultations are what grow a clinic. Everything we build is measured by the calls and enquiries it brings in.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
<div class="card" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 16px">
<span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></span>
<h3 style="font-size: 22px; line-height: 1.3; font-weight: 700; color: var(--ink); margin-top: 8px">Get Found on Google</h3>
<p style="font-size: 16px">Show up when nearby patients search for the treatments you offer, from Botox and fillers to veneers and implants, in Google Search and Maps.</p>
</div>
<div class="card" style="background: var(--blue); border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 16px; color: #fff; position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 240px; height: 240px; border-radius: 50%; background: rgba(255,255,255,0.08); right: -80px; top: -80px"></div>
<span style="width: 56px; height: 56px; border-radius: 16px; background: rgba(255,255,255,0.16); color: #fff; display: flex; align-items: center; justify-content: center; position: relative"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path><path d="m9 15 2 2 4-4"></path></svg></span>
<h3 style="font-size: 22px; line-height: 1.3; font-weight: 700; color: #fff; margin-top: 8px; position: relative">Turn Visitors Into Consultations</h3>
<p style="font-size: 16px; color: #EEF2FF; position: relative">Fast, trustworthy clinic websites with clear treatment pages and booking paths that make enquiring the easy next step.</p>
</div>
<div class="card" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 16px">
<span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1Z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path></svg></span>
<h3 style="font-size: 22px; line-height: 1.3; font-weight: 700; color: var(--ink); margin-top: 8px">Drive Real Enquiries, Not Clicks</h3>
<p style="font-size: 16px">Google, Facebook and Instagram campaigns aimed at people ready to book, tracked to calls and form enquiries rather than vanity metrics.</p>
</div>
</div>
</div>
</section>

<!-- ============ SERVICES (component: ServiceCards) ============ -->
<section style="background: var(--tint)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px; margin: 0 auto">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">Our services</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink); text-wrap: balance">Everything your clinic needs to get booked</h2>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
<a class="card" href="/services/web-development/" style="background: #fff; border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 16px; color: inherit">
<span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg></span>
<h3 style="font-size: 22px; line-height: 1.3; font-weight: 700; color: var(--ink); margin-top: 8px">Web Development</h3>
<p style="font-size: 16px">Fast, secure, SEO-ready clinic websites built to turn visitors into consultations.</p>
<ul style="list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: var(--ink); font-weight: 500">
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Mobile-first, conversion-focused design</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Treatment pages written to rank</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Booking and enquiry forms built in</li>
</ul>
<span class="tlink" style="margin-top: auto; padding-top: 12px">Learn more <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="card" href="/services/seo/" style="background: #fff; border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 16px; color: inherit">
<span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path><path d="M8 11h6M11 8v6"></path></svg></span>
<h3 style="font-size: 22px; line-height: 1.3; font-weight: 700; color: var(--ink); margin-top: 8px">SEO</h3>
<p style="font-size: 16px">Get found on Google for treatments like Botox, fillers, veneers and implants, and own your local search results.</p>
<ul style="list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: var(--ink); font-weight: 500">
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Local search and Google Maps visibility</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Treatment keyword strategy</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>On-page and technical SEO</li>
</ul>
<span class="tlink" style="margin-top: auto; padding-top: 12px">Learn more <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="card" href="/services/paid-advertising/" style="background: #fff; border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 16px; color: inherit">
<span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.5"></circle></svg></span>
<h3 style="font-size: 22px; line-height: 1.3; font-weight: 700; color: var(--ink); margin-top: 8px">Paid Advertising</h3>
<p style="font-size: 16px">Google, Facebook and Instagram ads that drive real enquiries, not clicks.</p>
<ul style="list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: var(--ink); font-weight: 500">
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Search campaigns for high-intent treatments</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Facebook and Instagram campaigns</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Call and form tracking</li>
</ul>
<span class="tlink" style="margin-top: auto; padding-top: 12px">Learn more <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>
</section>

<!-- ============ INDUSTRIES (component: IndustryCards) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">Industries</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink)">Your Industry, Our Expertise</h2>
<p style="text-wrap: pretty">We specialise in clinics, and we bring the same care to custom websites for businesses that want to stand out.</p>
</div>
<a class="btn btn-ghost" href="/portfolio/">View Our Work</a>
</div>
