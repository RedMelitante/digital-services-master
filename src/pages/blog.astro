---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ssrValues } from '../scripts/logic';
import '../styles/pages/blog.css';

const v = ssrValues('blog');
---
<BaseLayout title={'Blog — Digital Services Master'} description={'Practical guides on websites, SEO and ads for aesthetic and dental clinics, written by the team that builds them.'} nav="blog" logic="blog">
<!-- ============ BLOG HERO ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div style="position: relative; max-width: 860px; margin: 0 auto; padding: clamp(48px, 7vw, 80px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Blog</span></nav>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Marketing insights for <span style="color: var(--blue)">clinic owners</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 620px">Practical guides on websites, SEO and ads for aesthetic and dental clinics, written by the team that builds them.</p>
</div>
</section>

<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 32px) clamp(72px, 9vw, 112px); display: flex; flex-direction: column; gap: 40px">

<!-- Topic filter -->
<div role="group" aria-label="Filter articles by topic" style="align-self: center; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 6px; background: var(--tint2); border: 1px solid var(--line); border-radius: 28px">
<button data-b class="tab" aria-pressed={v.pAll ? 'true' : 'false'} data-b-aria-pressed="{{pAll}}" data-b-click="setAll" style={`background: ${v.bgAll}; color: ${v.fgAll}`} data-b-style="background: {{bgAll}}; color: {{fgAll}}">All articles</button>
<button data-b class="tab" aria-pressed={v.pCM ? 'true' : 'false'} data-b-aria-pressed="{{pCM}}" data-b-click="setCM" style={`background: ${v.bgCM}; color: ${v.fgCM}`} data-b-style="background: {{bgCM}}; color: {{fgCM}}">Clinic Marketing</button>
<button data-b class="tab" aria-pressed={v.pWD ? 'true' : 'false'} data-b-aria-pressed="{{pWD}}" data-b-click="setWD" style={`background: ${v.bgWD}; color: ${v.fgWD}`} data-b-style="background: {{bgWD}}; color: {{fgWD}}">Web Design</button>
<button data-b class="tab" aria-pressed={v.pSEO ? 'true' : 'false'} data-b-aria-pressed="{{pSEO}}" data-b-click="setSEO" style={`background: ${v.bgSEO}; color: ${v.fgSEO}`} data-b-style="background: {{bgSEO}}; color: {{fgSEO}}">SEO</button>
<button data-b class="tab" aria-pressed={v.pAD ? 'true' : 'false'} data-b-aria-pressed="{{pAD}}" data-b-click="setAD" style={`background: ${v.bgAD}; color: ${v.fgAD}`} data-b-style="background: {{bgAD}}; color: {{fgAD}}">Paid Ads</button>
<button data-b class="tab" aria-pressed={v.pDM ? 'true' : 'false'} data-b-aria-pressed="{{pDM}}" data-b-click="setDM" style={`background: ${v.bgDM}; color: ${v.fgDM}`} data-b-style="background: {{bgDM}}; color: {{fgDM}}">Dental Marketing</button>
</div>

<!-- Featured post -->

<a data-b data-b-if="sCM" hidden={!v.sCM} class="card" href="/blog/digital-marketing-for-aesthetic-clinics/" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); background: var(--navy); border-radius: 32px; overflow: hidden; color: #fff">
<img src="/images/post-digital-marketing-for-aesthetic-clinics--fm.webp" alt="" style="display: block; width: 100%; height: 100%; min-height: 320px; object-fit: cover" loading="lazy" decoding="async">
<div style="padding: clamp(32px, 4vw, 52px); display: flex; flex-direction: column; justify-content: center; gap: 16px">
<div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center"><span style="font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); background: var(--accent); border-radius: 999px; padding: 4px 12px">Featured guide</span><span style="font-size: 14px; color: #B9C3E3; font-weight: 600">Clinic Marketing · July 16, 2026</span></div>
<h2 style="font-size: clamp(26px, 2.6vw, 36px); line-height: 1.2; letter-spacing: -0.02em; font-weight: 800; color: #fff; text-wrap: balance">Digital Marketing for Aesthetic Clinics: The Complete Guide to Bookings, Local SEO &amp; Compliant Ads</h2>
<p style="color: #C9D3F2">Aesthetic clinics must build deep trust and capture hyper-local intent to win patients online.</p>
<span style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: #8BE9F0">Read the guide <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
</div>
</a>


<!-- Post grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 24px">
<a data-b data-b-if="sAD" hidden={!v.sAD} class="card" href="/blog/google-ads-for-aesthetic-clinics/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-google-ads-for-aesthetic-clinics-complet-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #FFF1E3" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #9A4D00">Paid Ads</span>·<span>July 16, 2026</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Google Ads for Aesthetic Clinics: Complete Campaign Setup Guide</h3><p style="font-size: 15px">Google Ads captures existing, high-intent searchers right when they are ready to book.</p></div></a>
<a data-b data-b-if="sSEO" hidden={!v.sSEO} class="card" href="/blog/local-seo-google-maps-playbook-for-aesthetic-clinics/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-local-seo-google-maps-playbook-for-aesth-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #E6F4EC" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #1F6B48">SEO</span>·<span>July 16, 2026</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Local SEO &amp; Google Maps Playbook for Aesthetic Clinics</h3><p style="font-size: 15px">Appearing in Google's Map Pack is essential for capturing high-intent, local patient searches when they are ready to book.</p></div></a>
<a data-b data-b-if="sWD" hidden={!v.sWD} class="card" href="/blog/aesthetic-clinic-website-design/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-aesthetic-clinic-website-design-what-act-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEF3FF" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #3D66E4">Web Design</span>·<span>July 16, 2026</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Aesthetic Clinic Website Design: What Actually Converts Visitors Into Consultations</h3><p style="font-size: 15px">Aesthetic clinic websites need strategic conversion engineering, not just visual polish, to turn casual browsers into booked appointments.</p></div></a>
<a data-b data-b-if="sSEO" hidden={!v.sSEO} class="card" href="/blog/how-to-choose-the-right-seo-expert-in-the-philippines/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-how-to-choose-the-right-seo-expert-in-th-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #E6F4EC" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #1F6B48">SEO</span>·<span>March 19, 2025</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">How to Choose the Right SEO Expert in the Philippines</h3></div></a>
<a data-b data-b-if="sWD" hidden={!v.sWD} class="card" href="/blog/why-website-developers-prioritize-responsive-design/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-why-website-developers-prioritize-respon-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEF3FF" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #3D66E4">Web Design</span>·<span>March 19, 2025</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Why Website Developers Prioritize Responsive Design</h3></div></a>
<a data-b data-b-if="sDM" hidden={!v.sDM} class="card" href="/blog/content-ideas-for-dental-marketing/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-digital-marketing-for-dental-clinics-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #E3F5F6" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #0B6770">Dental Marketing</span>·<span>March 18, 2025</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Content Ideas for Dental Marketing</h3></div></a>
<a data-b data-b-if="sDM" hidden={!v.sDM} class="card" href="/blog/trending-dental-marketing-topics/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-trending-dental-marketing-topics-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #E3F5F6" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #0B6770">Dental Marketing</span>·<span>March 18, 2025</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Trending Dental Marketing Topics</h3></div></a>
<a data-b data-b-if="sWD" hidden={!v.sWD} class="card" href="/blog/responsive-web-design-and-development/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-responsive-web-design-and-development-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEF3FF" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #3D66E4">Web Design</span>·<span>December 27, 2024</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Responsive Web Design and Development: Reaching All Devices</h3></div></a>
<a data-b data-b-if="sWD" hidden={!v.sWD} class="card" href="/blog/web-design-agency/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-web-design-agency-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEF3FF" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #3D66E4">Web Design</span>·<span>December 17, 2024</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">Transform Your Website: How a Web Design Agency Can Revitalize Your Online Presence</h3></div></a>
<a data-b data-b-if="sWD" hidden={!v.sWD} class="card" href="/blog/7-essential-principles-of-effective-ui-designs/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-7-essential-principles-of-effective-ui-d-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEF3FF" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #3D66E4">Web Design</span>·<span>December 16, 2024</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">7 Essential Principles of Effective UI Designs</h3></div></a>
<a data-b data-b-if="sSEO" hidden={!v.sSEO} class="card" href="/blog/seo-best-practices-for-2024/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-seo-best-practices-for-2024-focus-on-the-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #E6F4EC" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #1F6B48">SEO</span>·<span>November 11, 2024</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">SEO Best Practices for 2024: Focus on the Latest Strategies and Techniques</h3></div></a>
<a data-b data-b-if="sDT" hidden={!v.sDT} class="card" href="/blog/the-future-of-digital-services/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-the-future-of-digital-services-embracing-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEEAF7" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #4B3A7A">Digital Trends</span>·<span>November 11, 2024</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">The Future of Digital Services: Embracing Digital Transformation</h3></div></a>
<a data-b data-b-if="sWD" hidden={!v.sWD} class="card" href="/blog/from-offline-to-online/" style="background: #fff; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/post-from-offline-to-online-your-guide-to-bui-fm.webp" alt="" style="display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #EEF3FF" loading="lazy" decoding="async"><div style="padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1"><span style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; font-weight: 600; color: var(--muted)"><span style="color: #3D66E4">Web Design</span>·<span>November 11, 2024</span></span><h3 style="font-size: 19px; line-height: 1.35; font-weight: 700; color: var(--ink); text-wrap: pretty">From Offline to Online: Your Guide to Building a Winning Website Development in the Philippines</h3></div></a>
</div>

</div>
</section>

<!-- ============ CTA BAND (CtaBand) ============ -->
<section style="background: #fff; padding: 0 clamp(16px, 4vw, 32px) clamp(72px, 9vw, 112px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Rather we just do it for you?</h2><p style="color: #C9D3F2; font-size: 18px">Book a free Clinic Growth Audit and we'll show you exactly what to fix first.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/services/">Our Services</a></div>
</div>
</section>
</BaseLayout>
