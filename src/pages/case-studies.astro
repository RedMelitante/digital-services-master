<div style="position: absolute; right: clamp(16px, 3vw, 32px); bottom: -28px; width: 30%; background: #fff; border-radius: 20px; padding: 6px; box-shadow: 0 26px 44px -20px rgba(13,24,56,0.45)"><img src="/images/above-photo.webp" alt="Above Dental Care" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: center top; border-radius: 15px" loading="lazy" decoding="async"></div>
