---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/portfolio-pages.css';
---
<BaseLayout title={'Case Studies — Digital Services Master'} description={'How we helped dental clinics in the Philippines get found on Google, take more bookings online and keep patients coming back.'} nav="portfolio" logic="base">
<!-- ============ CASE STUDIES HERO ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><a href="/web-design-portfolio/" style="color: var(--muted)">Portfolio</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Case Studies</span></nav>
<p class="eb">Case Studies</p>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance; max-width: 860px">Real results for <span style="color: var(--blue)">dental clinics</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 680px; text-wrap: pretty">How we helped dental clinics in the Philippines get found on Google, take more bookings online and keep patients coming back.</p>
<div style="width: 100%; margin-top: 18px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px; text-align: left"><div style="background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 8px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">#1</p><p style="font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.4">On Google for “TMJ Clinic in Cagayan”</p><p style="font-size: 13px; font-weight: 600; color: var(--muted)">Sia-Tankiko</p></div><div style="background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 8px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">80%</p><p style="font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.4">More new patient inquiries</p><p style="font-size: 13px; font-weight: 600; color: var(--muted)">Above Dental Care</p></div><div style="background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 8px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">50%</p><p style="font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.4">More traffic from organic search</p><p style="font-size: 13px; font-weight: 600; color: var(--muted)">Millennium Smiles</p></div><div style="background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 24px; display: flex; flex-direction: column; gap: 8px"><p style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--blue); letter-spacing: -0.03em">40%</p><p style="font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.4">More online appointment bookings</p><p style="font-size: 13px; font-weight: 600; color: var(--muted)">Sia-Tankiko</p></div></div>
</div>
</section>

<!-- ============ CASE STUDIES ============ -->
<section style="background: #fff">
