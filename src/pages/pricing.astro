---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ssrValues } from '../scripts/logic';
import { PLAN_SETS } from '../data/pricing';
import '../styles/pages/pricing.css';

const v = ssrValues('pricing');
---
<BaseLayout title={'Pricing — Digital Services Master'} description={'Choose a website package or a monthly growth plan. Not sure what you need? Start with a free Clinic Growth Audit and we\'ll recommend the right fit.'} nav="pricing" logic="pricing">
<!-- ============ PRICING HERO + PLANS ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 4vw, 32px) clamp(64px, 8vw, 104px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; max-width: 760px; margin: 0 auto">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Pricing</span></nav>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Simple plans for clinics that want <span style="color: var(--blue)">more bookings</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 620px">Choose a website package or a monthly growth plan. Not sure what you need? Start with a free Clinic Growth Audit and we'll recommend the right fit.</p>
</div>
<div role="group" aria-label="Choose a plan type" style="align-self: center; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 6px; background: #fff; border: 1px solid var(--line); border-radius: 999px">
<button data-b class="tab" aria-pressed={v.pW ? 'true' : 'false'} data-b-aria-pressed="{{pW}}" data-b-click="setW" style={`background: ${v.bgW}; color: ${v.fgW}`} data-b-style="background: {{bgW}}; color: {{fgW}}">Website Packages</button>
<button data-b class="tab" aria-pressed={v.pG ? 'true' : 'false'} data-b-aria-pressed="{{pG}}" data-b-click="setG" style={`background: ${v.bgG}; color: ${v.fgG}`} data-b-style="background: {{bgG}}; color: {{fgG}}">Monthly Growth Plans</button>
</div>
{PLAN_SETS.map((ps) => (<Fragment>
<p data-b data-b-if={`p${ps.key}`} hidden={!v[`p${ps.key}`]} style="text-align: center; font-size: 16px; max-width: 640px; margin: -8px auto 0">{ps.intro}</p>
<div data-b data-b-if={`p${ps.key}`} hidden={!v[`p${ps.key}`]} style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px; align-items: stretch">
<div style="background: #fff; border: 1px solid var(--line); border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 22px">
<div style="display: flex; flex-direction: column; gap: 8px"><p style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted)">{ps.group}</p><h2 style="font-size: 24px; font-weight: 800; color: var(--ink)">{ps.plans[0].name}</h2><p style="font-size: 15px">{ps.plans[0].best}</p></div>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--ink); letter-spacing: -0.03em">{ps.plans[0].price}</span><span style="font-size: 15px; color: var(--muted)">{ps.suffix}</span></div>
<a class="btn btn-ghost" href="/contact/" style="width: 100%">{ps.plans[0].cta}</a>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 15px; color: var(--ink)">
{ps.plans[0].features.map((ft) => (<Fragment><li class="li"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>{ft}</li></Fragment>))}
</ul>
</div>
<div style="background: var(--navy); border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 22px; color: #fff; position: relative; overflow: hidden; box-shadow: 0 40px 70px -40px rgba(13,24,56,0.6)">
<div aria-hidden="true" style="position: absolute; width: 260px; height: 260px; border-radius: 50%; background: #1E42B1; right: -100px; top: -110px; opacity: 0.8"></div>
<span style="position: relative; align-self: flex-start; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); background: var(--accent); border-radius: 999px; padding: 5px 12px">Recommended</span>
<div style="position: relative; display: flex; flex-direction: column; gap: 8px"><p style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #B9C3E3">{ps.group}</p><h2 style="font-size: 24px; font-weight: 800; color: #fff">{ps.plans[1].name}</h2><p style="font-size: 15px; color: #C9D3F2">{ps.plans[1].best}</p></div>
<div style="position: relative; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 44px; line-height: 1; font-weight: 800; color: #fff; letter-spacing: -0.03em">{ps.plans[1].price}</span><span style="font-size: 15px; color: #B9C3E3">{ps.suffix}</span></div>
<a class="btn btn-cta" href="/contact/" style="position: relative; width: 100%">{ps.plans[1].cta}</a>
<ul style="position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 15px; color: #E3E8F7">
{ps.plans[1].features.map((ft) => (<Fragment><li class="li"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8BE9F0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>{ft}</li></Fragment>))}
</ul>
</div>
<div style="background: #fff; border: 1px solid var(--line); border-radius: 28px; padding: 36px; display: flex; flex-direction: column; gap: 22px">
<div style="display: flex; flex-direction: column; gap: 8px"><p style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted)">{ps.group}</p><h2 style="font-size: 24px; font-weight: 800; color: var(--ink)">{ps.plans[2].name}</h2><p style="font-size: 15px">{ps.plans[2].best}</p></div>
<div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap"><span style="font-size: 44px; line-height: 1; font-weight: 800; color: var(--ink); letter-spacing: -0.03em">{ps.plans[2].price}</span><span style="font-size: 15px; color: var(--muted)">{ps.suffix}</span></div>
<a class="btn btn-ghost" href="/contact/" style="width: 100%">{ps.plans[2].cta}</a>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 15px; color: var(--ink)">
{ps.plans[2].features.map((ft) => (<Fragment><li class="li"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>{ft}</li></Fragment>))}
</ul>
</div>
</div>
</Fragment>))}
<p style="text-align: center; font-size: 14px; color: var(--muted)">Prices in Philippine pesos (PHP). Need something different? We can build a custom plan around your clinic.</p>
</div>
</section>

<!-- ============ EVERY PLAN INCLUDES ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 104px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px"><p class="eb">Every plan includes</p><h2 class="h2">The basics every clinic deserves</h2></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px">
<div style="border: 1px solid var(--line); border-radius: 24px; padding: 26px; display: flex; flex-direction: column; gap: 10px"><span style="width: 48px; height: 48px; border-radius: 14px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></span><h3 style="font-size: 17px; font-weight: 700; color: var(--ink)">A free Clinic Growth Audit</h3><p style="font-size: 15px">We start by finding what will bring you the most bookings.</p></div>
<div style="border: 1px solid var(--line); border-radius: 24px; padding: 26px; display: flex; flex-direction: column; gap: 10px"><span style="width: 48px; height: 48px; border-radius: 14px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg></span><h3 style="font-size: 17px; font-weight: 700; color: var(--ink)">Enquiry tracking</h3><p style="font-size: 15px">Calls and forms measured, so you can see what's working.</p></div>
<div style="border: 1px solid var(--line); border-radius: 24px; padding: 26px; display: flex; flex-direction: column; gap: 10px"><span style="width: 48px; height: 48px; border-radius: 14px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg></span><h3 style="font-size: 17px; font-weight: 700; color: var(--ink)">Plain-English reporting</h3><p style="font-size: 15px">Clear updates on results, without the jargon.</p></div>
<div style="border: 1px solid var(--line); border-radius: 24px; padding: 26px; display: flex; flex-direction: column; gap: 10px"><span style="width: 48px; height: 48px; border-radius: 14px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path d="M3 20a6 6 0 0 1 12 0M16 4a3 3 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"></path></svg></span><h3 style="font-size: 17px; font-weight: 700; color: var(--ink)">One team under one roof</h3><p style="font-size: 15px">Web, SEO and ads handled together by the same people.</p></div>
</div>
</div>
</section>

<!-- ============ FAQ (FaqAccordion) ============ -->
<section style="background: var(--tint)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: clamp(40px, 6vw, 96px); align-items: start">
<div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start"><p class="eb">Pricing FAQ</p><h2 class="h2">Questions about plans and pricing</h2><a class="btn btn-ghost" href="/contact/" style="margin-top: 8px">Get in Touch</a></div>
<div style="display: flex; flex-direction: column; border-top: 1px solid #D6DEEF; background: transparent">
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open0 ? 'true' : 'false'} data-b-aria-expanded="{{open0}}" data-b-click="toggle0">Which plan is right for my clinic?<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot0}; transition: transform .2s`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot0}}; transition: transform .2s"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open0" hidden={!v.open0} style="padding: 0 52px 24px 0; font-size: 16px">It depends on your goals, your market and where you are today. Book a free Clinic Growth Audit and we'll recommend the plan that fits.</p></div>
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open1 ? 'true' : 'false'} data-b-aria-expanded="{{open1}}" data-b-click="toggle1">Can I combine services?<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot1}; transition: transform .2s`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot1}}; transition: transform .2s"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open1" hidden={!v.open1} style="padding: 0 52px 24px 0; font-size: 16px">Yes. Your website, SEO and ads work best together, and we can put together a combined plan for your clinic.</p></div>
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open2 ? 'true' : 'false'} data-b-aria-expanded="{{open2}}" data-b-click="toggle2">Is the Clinic Growth Audit really free?<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot2}; transition: transform .2s`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot2}}; transition: transform .2s"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open2" hidden={!v.open2} style="padding: 0 52px 24px 0; font-size: 16px">Yes. There's no cost and no obligation. You'll get a clear picture of what to fix first, whether or not you work with us.</p></div>
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open3 ? 'true' : 'false'} data-b-aria-expanded="{{open3}}" data-b-click="toggle3">What does the Full Funnel plan add?<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot3}; transition: transform .2s`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot3}}; transition: transform .2s"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open3" hidden={!v.open3} style="padding: 0 52px 24px 0; font-size: 16px">Everything in Growth, plus four blog or content pieces a month, Google Ads and Meta (Facebook &amp; Instagram) Ads management, landing page and conversion optimisation, ad creative direction and bi-weekly reporting.</p></div>
</div>
</div>
</section>

<!-- ============ CTA BAND (CtaBand) ============ -->
<section style="background: #fff; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Need a custom plan?</h2><p style="color: #C9D3F2; font-size: 18px">Multi-location clinic or a bigger project? Start with a free audit and we'll put together a plan around your goals.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/contact/">Get in Touch</a></div>
</div>
</section>
</BaseLayout>
