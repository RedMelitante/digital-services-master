---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ssrValues } from '../../scripts/logic';
import { INDUSTRIES, INDUSTRY_PAGES } from '../../data/industries';
import '../../styles/pages/industry.css';

export const getStaticPaths = (() =>
  INDUSTRY_PAGES.map(({ slug, key }) => ({ params: { slug }, props: { key } }))) satisfies GetStaticPaths;

const { key } = Astro.props;
const d = INDUSTRIES[key];
const hasShot = !!d.shot;
const noShot = !d.shot;
const v = ssrValues('accordion3');
---
<BaseLayout logic="accordion3">
<!-- ============ INDUSTRY HERO ============ -->
<section style="background: var(--tint2); overflow: hidden">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) clamp(16px, 4vw, 32px) clamp(64px, 8vw, 104px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); gap: clamp(48px, 5vw, 72px); align-items: center">
<div style="display: flex; flex-direction: column; gap: 26px; align-items: flex-start">
<nav aria-label="Breadcrumb" style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><span>Industries</span><span aria-hidden="true">/</span><span style="color: var(--ink)">{d.label}</span></nav>
<span style="display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px 8px 10px; font-size: 14px; font-weight: 600; color: var(--ink)"><span style={`width: 24px; height: 24px; border-radius: 50%; background: ${d.bg}; border: 2px solid ${d.deep}`}></span>Marketing for {d.labelLower}</span>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">{d.h1a} <span style="color: var(--blue)">{d.h1b}</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 540px; text-wrap: pretty">{d.sub}</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact-website-development-services/">Book a Free Clinic Growth Audit</a><a class="btn btn-ghost" href="/web-design-portfolio/">View Our Work</a></div>
</div>
<div style="position: relative; min-height: 440px; display: flex; align-items: center; justify-content: center">
<div aria-hidden="true" style={`position: absolute; width: 86%; aspect-ratio: 1; border-radius: 50%; background: ${d.bg}; right: -8%; top: 50%; transform: translateY(-50%)`}></div>
{hasShot && (<Fragment><div style="position: relative; width: 92%; background: #fff; border-radius: 16px 16px 6px 6px; overflow: hidden; box-shadow: 0 40px 70px -30px rgba(13,24,56,0.45); border: 1px solid var(--line)"><div style="display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: var(--tint2)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #FF8A80"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #FFD166"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #7BD88F"></span><span style="margin-left: 8px; flex: 1; max-width: 240px; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12px; color: #646B88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">{d.shotUrl}</span></div><img src={`${d.shot}`} alt={`${d.shotAlt}`} style="display: block; width: 100%; height: auto" decoding="async"></div></Fragment>)}
{noShot && (<Fragment><div style="position: relative; width: 92%; background: #fff; border-radius: 16px 16px 6px 6px; overflow: hidden; box-shadow: 0 40px 70px -30px rgba(13,24,56,0.45); border: 1px solid var(--line)">
<div style="display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: var(--tint2)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #FF8A80"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #FFD166"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #7BD88F"></span><span style="margin-left: 8px; flex: 1; max-width: 240px; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12px; color: #646B88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">yourclinic.com</span></div>
<div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 22px; border-bottom: 1px solid var(--line)"><span style={`font-size: 16px; font-weight: 800; color: ${d.deep}; letter-spacing: -0.01em`}>{d.screenName}</span><span style={`font-size: 12px; font-weight: 700; color: #fff; background: ${d.deep}; border-radius: 999px; padding: 7px 14px; white-space: nowrap`}>Book online</span></div>
<div style="display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; padding: 26px 22px 30px; align-items: center">
<div style="display: flex; flex-direction: column; gap: 12px"><span style="font-size: clamp(18px, 1.9vw, 26px); font-weight: 800; line-height: 1.15; color: var(--ink); letter-spacing: -0.02em">{d.screenHead}</span><span style="width: 88%; height: 8px; border-radius: 8px; background: #E9EDF5"></span><span style="width: 64%; height: 8px; border-radius: 8px; background: #E9EDF5"></span><span style={`align-self: flex-start; margin-top: 6px; font-size: 12px; font-weight: 700; color: #fff; background: ${d.deep}; border-radius: 999px; padding: 8px 16px`}>Book an appointment</span></div>
<div style={`aspect-ratio: 1; border-radius: 20px; background: ${d.bg}; position: relative; overflow: hidden`}><div style={`position: absolute; width: 74%; aspect-ratio: 1; border-radius: 50%; background: ${d.mid}; right: -14%; bottom: -16%`}></div><div style="position: absolute; left: 14%; top: 16%; width: 46%; height: 22%; border-radius: 12px; background: #fff"></div></div>
</div>
</div></Fragment>)}
<div style="position: absolute; bottom: 4%; left: 0; background: #fff; border-radius: 18px; padding: 14px 18px 14px 14px; display: flex; gap: 12px; align-items: center; box-shadow: 0 24px 40px -20px rgba(13,24,56,0.35); border: 1px solid var(--line)">
<span style="width: 42px; height: 42px; border-radius: 12px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path><path d="m9 15 2 2 4-4"></path></svg></span>
<span style="display: flex; flex-direction: column; line-height: 1.3"><span style="font-size: 14px; font-weight: 700; color: var(--ink)">New booking request</span><span style="font-size: 13px; color: var(--muted)">via website</span></span>
</div>
</div>
</div>
</section>

<!-- ============ CHALLENGES ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px; margin: 0 auto"><p class="eb">We understand your patients</p><h2 class="h2">What makes marketing {d.labelLower} different</h2></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
{d.challenges.map((c) => (<Fragment>
<div style="border: 1px solid var(--line); border-radius: 28px; padding: 34px; display: flex; flex-direction: column; gap: 12px"><span style={`font-size: 14px; font-weight: 800; color: ${d.deep}`}>0{c.n}</span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); line-height: 1.3">{c.t}</h3><p style="font-size: 16px">{c.d}</p></div>
</Fragment>))}
</div>
</div>
</section>

<!-- ============ HOW WE HELP (services) ============ -->
<section style="background: var(--tint)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px; margin: 0 auto"><p class="eb">How we help</p><h2 class="h2">Website, Google and ads working together for your {d.noun}</h2></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
<a class="card" href="/web-development-seo-google-ads-services/website-development/" style="background: #fff; border-radius: 28px; padding: 34px; display: flex; flex-direction: column; gap: 12px; color: inherit"><span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg></span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Web Development</h3><p style="font-size: 16px">{d.web}</p><span class="tlink" style="margin-top: auto; padding-top: 8px">Learn more →</span></a>
<a class="card" href="/seo-services-in-the-philippines/" style="background: #fff; border-radius: 28px; padding: 34px; display: flex; flex-direction: column; gap: 12px; color: inherit"><span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">SEO</h3><p style="font-size: 16px">{d.seo}</p><span class="tlink" style="margin-top: auto; padding-top: 8px">Learn more →</span></a>
<a class="card" href="/google-ads-services/" style="background: #fff; border-radius: 28px; padding: 34px; display: flex; flex-direction: column; gap: 12px; color: inherit"><span style="width: 56px; height: 56px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.5"></circle></svg></span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Paid Advertising</h3><p style="font-size: 16px">{d.ads}</p><span class="tlink" style="margin-top: auto; padding-top: 8px">Learn more →</span></a>
</div>
</div>
</section>

<!-- ============ SEARCHES WE TARGET ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: clamp(40px, 6vw, 88px); align-items: center">
<div style="display: flex; flex-direction: column; gap: 18px; align-items: flex-start"><p class="eb">Get found on Google</p><h2 class="h2">Show up for the searches that lead to bookings</h2><p>We focus on the high-intent and “near me” searches in your area that turn into calls and appointment requests.</p></div>
<div style={`background: ${d.bg}; border-radius: 32px; padding: 40px; display: flex; flex-wrap: wrap; gap: 12px`}>
{d.keywords.map((k) => (<Fragment><span class="kw">{k}</span></Fragment>))}
</div>
</div>
</section>

<!-- ============ RELATED WORK ============ -->
<section style="background: var(--tint2)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px"><div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px"><p class="eb">Our work</p><h2 class="h2">{d.workTitle}</h2></div><a class="btn btn-ghost" href="/web-design-portfolio/">View Our Work</a></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
{d.work.map((w) => (<Fragment>
<a class="card" href={w.href} style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit">
<img src={w.img} alt={w.name} style={`display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: ${w.bg}`} loading="lazy" decoding="async">
<div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">{w.type}</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">{w.name}</h3></div>
</a>
</Fragment>))}
</div>
</div>
</section>

<!-- ============ TESTIMONIAL ============ -->
<section style="background: #fff">
<div style="max-width: 1000px; margin: 0 auto; padding: clamp(64px, 8vw, 104px) clamp(16px, 4vw, 32px)">
<figure style="margin: 0; display: flex; flex-direction: column; gap: 26px; align-items: center; text-align: center">
<svg width="44" height="36" viewBox="0 0 40 32" aria-hidden="true"><path d="M0 32V19C0 8.5 5.5 2 16 0l2 5c-6 1.6-8.6 5-9 10h8v17H0Zm22 0V19c0-10.5 5.5-17 16-19l2 5c-6 1.6-8.6 5-9 10h8v17H22Z" fill="#3D66E4"></path></svg>
<blockquote style="margin: 0; font-size: clamp(20px, 2vw, 26px); line-height: 1.5; color: var(--ink); font-weight: 600; max-width: 780px">Red is amazing! He goes above and beyond always and makes life so easy. His output is excellent and I have gained clients from his work.</blockquote>
<figcaption style="display: flex; align-items: center; gap: 14px"><img src="/images/av-aubry.webp" alt="Aubry Ann" style="width: 52px; height: 52px; border-radius: 50%; object-fit: cover; flex: none" loading="lazy" decoding="async"><span style="display: flex; flex-direction: column; line-height: 1.35; text-align: left"><span style="font-weight: 700; color: var(--ink)">Aubry Ann</span><span style="font-size: 15px; color: var(--muted)">CEO, Coastal Luxe Aesthetics</span></span></figcaption>
</figure>
</div>
</section>

<!-- ============ FAQ ============ -->
<section style="background: var(--tint)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: clamp(40px, 6vw, 96px); align-items: start">
<div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start"><p class="eb">FAQ</p><h2 class="h2">Questions from {d.noun} owners</h2><a class="btn btn-ghost" href="/faqs-website-development/" style="margin-top: 8px">All FAQs</a></div>
<div style="display: flex; flex-direction: column; border-top: 1px solid #D6DEEF">
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open0 ? 'true' : 'false'} data-b-aria-expanded="{{open0}}" data-b-click="toggle0"><span>Can you help a {d.noun} like mine?</span><span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot0}`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot0}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open0" hidden={!v.open0} style="padding: 0 52px 24px 0; font-size: 16px">Yes. Our process is built for clinics: we start with a free audit of your website, Google visibility and ads, then build a plan around the services you want to grow.</p></div>
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open1 ? 'true' : 'false'} data-b-aria-expanded="{{open1}}" data-b-click="toggle1">How long until I see results?<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot1}`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot1}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open1" hidden={!v.open1} style="padding: 0 52px 24px 0; font-size: 16px">Ads can bring enquiries soon after launch, while SEO builds steadily over months. Your free audit includes a realistic timeline for your clinic.</p></div>
<div style="border-bottom: 1px solid #D6DEEF"><button data-b class="faq-q" aria-expanded={v.open2 ? 'true' : 'false'} data-b-aria-expanded="{{open2}}" data-b-click="toggle2">Do you work outside the Philippines?<span data-b style={`width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: ${v.rot2}`} data-b-style="width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none; transform: {{rot2}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><p data-b data-b-if="open2" hidden={!v.open2} style="padding: 0 52px 24px 0; font-size: 16px">Yes. We work with clinics in both the Philippines and Australia, and our whole process runs smoothly online.</p></div>
</div>
</div>
</section>

<!-- ============ CTA BAND ============ -->
<section style="background: #fff; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Let's grow your {d.noun}'s bookings</h2><p style="color: #C9D3F2; font-size: 18px">Get a free Clinic Growth Audit: a clear look at your website, Google visibility and ads, with practical next steps.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact-website-development-services/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/contact-website-development-services/">Get in Touch</a></div>
</div>
</section>
</BaseLayout>
