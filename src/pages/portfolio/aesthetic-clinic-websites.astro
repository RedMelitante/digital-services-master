---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/portfolio-pages.css';
---
<BaseLayout nav="portfolio" logic="base">
<!-- ============ CATEGORY HERO ============ -->
<section style="background: var(--tint2); position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #DFE7FF; right: -140px; top: -160px"></div>
<div style="position: relative; max-width: 880px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px">
<nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><a href="/portfolio/" style="color: var(--muted)">Portfolio</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Aesthetic Clinics</span></nav>
<p class="eb">Aesthetic Clinics</p>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Aesthetic clinic websites that <span style="color: var(--blue)">attract more clients</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 640px; text-wrap: pretty">Your website is the first impression potential clients get of your aesthetic clinic. A well-designed website can boost trust, encourage appointments and highlight your clinic's services.</p>
</div>
</section>

<!-- ============ CATEGORY GRID ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 32px) 0; display: flex; flex-direction: column; gap: 40px">
<nav aria-label="Portfolio categories" style="align-self: center; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 6px; background: var(--tint2); border: 1px solid var(--line); border-radius: 28px"><a class="tab" href="/portfolio/">All work</a><span class="tab" aria-current="page" style="background: #131A33; color: #fff">Aesthetic Clinics</span><a class="tab" href="/portfolio/dental-clinic-websites/">Dental Clinics</a><a class="tab" href="/portfolio/custom-websites/">Business &amp; Service Websites</a><a class="tab" href="/portfolio/ecommerce-websites/">E-commerce Websites</a></nav>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 24px"><a class="card" href="/case-studies/coastal-luxe-aesthetics/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/cla-photo.webp" alt="Coastal Luxe Aesthetics" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F3ECE4" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Aesthetic Clinic · Case study</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Coastal Luxe Aesthetics</h3></div></a><a class="card" href="/contact/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/illum-photo.webp" alt="Illuminate Skin and Body" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F7EEE6" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Aesthetic Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Illuminate Skin and Body</h3></div></a><a class="card" href="/contact/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/dermal-photo.webp" alt="Dermal and Laser Clinic" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F4EAF0" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Aesthetic Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Dermal and Laser Clinic</h3></div></a><a class="card" href="/contact/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/venus-photo.webp" alt="Venus Medispa" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #EEEAF7" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Med Spa</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Venus Medispa</h3></div></a><a class="card" href="/contact/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/lamaison-photo.webp" alt="La Maison Beaute" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #F7E8EC" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Aesthetic Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">La Maison Beaute</h3></div></a><a class="card" href="/contact/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/aea-photo.webp" alt="Aesthetic Equipment Australia" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #EAF0F5" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Aesthetic Equipment Supplier</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Aesthetic Equipment Australia</h3></div></a></div>
</div>
</section>

<!-- ============ CTA BAND (CtaBand) ============ -->
<section style="background: #fff; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Let's build your next website</h2><p style="color: #C9D3F2; font-size: 18px">Start with a free Clinic Growth Audit of your current site, Google visibility and ads.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/portfolio/">All Work</a></div>
</div>
</section>
</BaseLayout>
