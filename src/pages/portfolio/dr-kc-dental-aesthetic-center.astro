---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/portfolio-pages.css';
---
<BaseLayout title={'Project: Dr. KC Dental Aesthetic Center — Digital Services Master'} description={'Clean, informative website for a local dental practice.'} nav="portfolio" logic="base">
<!-- ============ PROJECT HERO (ProjectHero) ============ -->
<section style="background: #EAF0F8; overflow: hidden">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) clamp(16px, 4vw, 32px) clamp(56px, 7vw, 88px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: clamp(40px, 5vw, 72px); align-items: center">
<div style="display: flex; flex-direction: column; gap: 22px; align-items: flex-start">
<nav aria-label="Breadcrumb" style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; font-weight: 600; color: #4A6A8A"><a href="/" style="color: #4A6A8A">Home</a><span aria-hidden="true">/</span><a href="/portfolio/" style="color: #4A6A8A">Portfolio</a><span aria-hidden="true">/</span><a href="/portfolio/dental-clinic-websites/" style="color: #4A6A8A">Dental Clinics</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Dr. KC Dental Aesthetic Center</span></nav>
<span style="font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #2A5A8C; background: #fff; border-radius: 999px; padding: 5px 14px">Project · Dental Clinic</span>
<h1 style="font-size: clamp(40px, 4.8vw, 62px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Dr. KC Dental Aesthetic Center</h1>
<p style="font-size: clamp(18px, 1.6vw, 21px); color: var(--ink); opacity: 0.85; max-width: 520px">Clean, informative website for a local dental practice.</p>
<dl style="margin: 6px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 16px 28px; width: 100%; font-size: 15px"><div><dt style="color: #4A6A8A; font-weight: 600">Industry</dt><dd style="margin: 0; color: var(--ink); font-weight: 700">Dental Clinic</dd></div><div><dt style="color: #4A6A8A; font-weight: 600">Website</dt><dd style="margin: 0; color: var(--ink); font-weight: 700"><a href="https://drkcdental.com" target="_blank" rel="noopener" style="color: #2A5A8C">drkcdental.com ↗</a></dd></div></dl>
</div>
<div style="position: relative; min-height: 420px; display: flex; align-items: center; justify-content: center">
<div style="width: 92%; background: #1A2036; border-radius: 18px 18px 6px 6px; padding: 11px 11px 15px; box-shadow: 0 40px 70px -30px rgba(13,24,56,0.45)">
<img src="/images/drkc-photo.webp" alt="Dr. KC Dental Aesthetic Center" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 6px" decoding="async">
</div>
<div style="position: absolute; right: 0; bottom: -4%; width: 34%; background: #fff; border-radius: 22px; padding: 6px; box-shadow: 0 30px 50px -20px rgba(13,24,56,0.45)"><img src="/images/drkc-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 16px" decoding="async"></div>
</div>
</div>
</section>

<!-- ============ STORY (ProjectStory) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 96px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 24px">
<article style="background: var(--navy); border-radius: 28px; padding: clamp(28px, 3.5vw, 44px); display: flex; flex-direction: column; gap: 14px"><p class="eb" style="color: #8BE9F0">What we built</p><p style="color: #E3E8F7; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.7; max-width: 900px">A clear, approachable digital presence that builds patient trust. With straightforward navigation, well-structured treatment pages and a mobile-friendly design, the site makes it easy for potential patients to learn about services and take action, whether booking an appointment or getting in touch.</p></article>
<article style="background: var(--tint2); border: 1px solid var(--line); border-radius: 28px; padding: clamp(28px, 3.5vw, 44px); display: flex; flex-direction: column; gap: 16px"><p class="eb">Highlights</p><ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 14px 32px; font-size: 16px; color: var(--ink); font-weight: 500"><li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Straightforward navigation</li><li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Well-structured treatment pages</li><li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Mobile-friendly design</li><li class="chk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Easy booking and enquiries from any page</li></ul></article>
</div>
</section>

<!-- ============ SCREENS (ScreenGallery) ============ -->
<section style="background: #EAF0F8">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 96px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 28px">
<h2 style="font-size: clamp(26px, 2.6vw, 34px); line-height: 1.2; letter-spacing: -0.02em; font-weight: 800; color: var(--ink)">Inside the website</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px"><figure style="margin: 0; display: flex; flex-direction: column; gap: 12px"><img src="/images/drkc-photo.webp" alt="Dr. KC Dental Aesthetic Center The clinic" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: center; border-radius: 24px; background: #fff" loading="lazy" decoding="async"><figcaption style="font-size: 15px; font-weight: 600; color: var(--ink)">The clinic</figcaption></figure></div>
</div>
</section>

<!-- ============ MORE PROJECTS ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 96px) clamp(16px, 4vw, 32px) 0; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px"><h2 style="font-size: clamp(28px, 2.8vw, 38px); line-height: 1.2; letter-spacing: -0.02em; font-weight: 800; color: var(--ink)">More dental clinics</h2><a class="btn btn-ghost" href="/portfolio/dental-clinic-websites/">See all</a></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px"><a class="card" href="/portfolio/above-dental-care/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/above-photo.webp" alt="Above Dental Care" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #E3F5F6" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Dental Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Above Dental Care</h3></div></a><a class="card" href="/portfolio/sia-tankiko-dental-clinic/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/sia-photo.webp" alt="Sia-Tankiko Dental Clinic" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #E6F4EC" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Dental Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Sia-Tankiko Dental Clinic</h3></div></a><a class="card" href="/portfolio/millennium-smiles-dental-center/" style="background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit"><img src="/images/mil-photo.webp" alt="Millennium Smiles Dental Center" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: #E8F1FB" loading="lazy" decoding="async"><div style="padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 6px"><span style="font-size: 13px; font-weight: 700; color: var(--muted)">Dental Clinic</span><h3 style="font-size: 20px; font-weight: 700; color: var(--ink)">Millennium Smiles Dental Center</h3></div></a></div>
</div>
</section>

<!-- ============ CTA BAND (CtaBand) ============ -->
<section style="background: #fff; padding: clamp(72px, 9vw, 112px) clamp(16px, 4vw, 32px)">
<div style="max-width: 1240px; margin: 0 auto; background: var(--navy); border-radius: 36px; padding: clamp(48px, 7vw, 88px) clamp(24px, 6vw, 80px); position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div aria-hidden="true" style="position: absolute; width: 420px; height: 420px; border-radius: 50%; background: #1E42B1; right: -120px; top: -180px; opacity: 0.7"></div>
<div aria-hidden="true" style="position: absolute; width: 120px; height: 120px; border-radius: 50%; background: #00C5D3; right: 22%; bottom: -60px; opacity: 0.35"></div>
<div style="position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 620px"><h2 style="font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: #fff">Want a website like this?</h2><p style="color: #C9D3F2; font-size: 18px">Book a free Clinic Growth Audit and we'll show you what a better website could do for your business.</p></div>
<div style="position: relative; display: flex; flex-wrap: wrap; gap: 14px"><a class="btn btn-cta" href="/contact/">Book a Free Clinic Growth Audit</a><a class="btn btn-light" href="/portfolio/">View Our Work</a></div>
</div>
</section>
</BaseLayout>
