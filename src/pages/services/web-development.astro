---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ssrValues } from '../../scripts/logic';
import '../../styles/pages/main-service-webdev.css';

const v = ssrValues('accordion4');
---
<BaseLayout title={'Web Development — Digital Services Master'} description={'Fast, secure, SEO-ready websites for aesthetic and dental clinics, designed around the way patients choose a clinic and book their first visit.'} nav="services" logic="accordion4">
<!-- ============ SERVICE HERO (PageHero + DeviceMockup) ============ -->
<section style="background: var(--tint2); overflow: hidden">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) clamp(16px, 4vw, 32px) clamp(64px, 8vw, 104px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); gap: clamp(48px, 5vw, 72px); align-items: center">
<div style="display: flex; flex-direction: column; gap: 26px; align-items: flex-start">
<nav aria-label="Breadcrumb" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--muted)"><a href="/" style="color: var(--muted)">Home</a><span aria-hidden="true">/</span><a href="/services/" style="color: var(--muted)">Services</a><span aria-hidden="true">/</span><span style="color: var(--ink)">Web Development</span></nav>
<span style="display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px 8px 10px; font-size: 14px; font-weight: 600; color: var(--ink)"><span style="width: 24px; height: 24px; border-radius: 50%; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg></span>Web Development</span>
<h1 style="font-size: clamp(38px, 4.4vw, 58px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; color: var(--ink); text-wrap: balance">Clinic websites built to turn visitors into <span style="color: var(--blue)">consultations</span></h1>
<p style="font-size: clamp(17px, 1.4vw, 19px); max-width: 540px; text-wrap: pretty">Fast, secure, SEO-ready websites for aesthetic and dental clinics, designed around the way patients choose a clinic and book their first visit.</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px">
<a class="btn btn-cta" href="/contact/">Book a Free Clinic Growth Audit <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
<a class="btn btn-ghost" href="/portfolio/">View Our Work</a>
</div>
</div>
<!-- Visual: real client website on laptop + phone (component: DeviceMockup) -->
<div style="position: relative; padding: 48px 0 40px">
<div aria-hidden="true" style="position: absolute; width: 84%; aspect-ratio: 1; border-radius: 50%; background: #DFE7FF; right: -6%; top: 50%; transform: translateY(-50%)"></div>
<div style="position: relative; width: 92%">
<div style="background: #1A2036; border-radius: 18px 18px 6px 6px; padding: 10px 10px 14px; box-shadow: 0 40px 70px -30px rgba(13,24,56,0.45)">
<div style="border-radius: 6px; overflow: hidden; background: #fff">
<div style="display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #F1F3F8"><span style="width: 8px; height: 8px; border-radius: 50%; background: #FF8A80"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #FFD166"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #7BD88F"></span><span style="margin-left: 8px; flex: 1; max-width: 240px; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12px; color: #646B88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">siatankikodentalclinic.com</span></div>
<img src="/images/sia-desk.webp" alt="Sia-Tankiko Dental Clinic website, built by Digital Services Master" style="display: block; width: 100%; height: auto" decoding="async">
</div>
</div>
<div style="height: 14px; margin: 0 -6%; background: #CDD3E2; border-radius: 0 0 18px 18px; box-shadow: inset 0 3px 0 #E6EAF3"></div>
</div>
<div style="position: absolute; right: 0; bottom: 8px; width: 24%; background: #1A2036; border-radius: 26px; padding: 7px; box-shadow: 0 30px 50px -20px rgba(13,24,56,0.5)">
<img src="/images/sia-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 9 / 17; object-fit: cover; border-radius: 20px" decoding="async">
</div>
<div style="position: absolute; top: 0; left: -3%; z-index: 2; display: flex; flex-wrap: wrap; gap: 10px">
<span style="display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 10px 16px; font-size: 14px; font-weight: 700; color: var(--ink); box-shadow: 0 18px 30px -18px rgba(13,24,56,0.35)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>Mobile-first</span>
<span style="display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 10px 16px; font-size: 14px; font-weight: 700; color: var(--ink); box-shadow: 0 18px 30px -18px rgba(13,24,56,0.35)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>SEO-ready</span>
</div>
</div>
</div>
</section>

<!-- ============ WHAT'S INCLUDED (FeatureGrid) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px; margin: 0 auto">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">What's included</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink); text-wrap: balance">Your website should work like your best front desk</h2>
<p style="text-wrap: pretty">Welcoming, informative and always ready to take the next booking.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 20px">
<div style="display: flex; gap: 20px; padding: 30px; border-radius: 24px; border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20 20 4M14 4h6v6"></path><path d="M4 10V4h6"></path></svg></span><span style="display: flex; flex-direction: column; gap: 8px"><h3 style="font-size: 19px; font-weight: 700; color: var(--ink)">Conversion-focused design</h3><p style="font-size: 16px">Layouts that lead visitors from treatment interest to booking, with a clear next step on every page.</p></span></div>
<div style="display: flex; gap: 20px; padding: 30px; border-radius: 24px; border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 8h8M8 12h8M8 16h5"></path></svg></span><span style="display: flex; flex-direction: column; gap: 8px"><h3 style="font-size: 19px; font-weight: 700; color: var(--ink)">Treatment pages that rank</h3><p style="font-size: 16px">A clear, search-friendly page for every treatment you want to grow, from fillers to implants.</p></span></div>
<div style="display: flex; gap: 20px; padding: 30px; border-radius: 24px; border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path><path d="m9 15 2 2 4-4"></path></svg></span><span style="display: flex; flex-direction: column; gap: 8px"><h3 style="font-size: 19px; font-weight: 700; color: var(--ink)">Booking &amp; enquiry flows</h3><p style="font-size: 16px">Enquiry forms, click-to-call and booking links placed where patients are ready to act.</p></span></div>
<div style="display: flex; gap: 20px; padding: 30px; border-radius: 24px; border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"></rect><path d="M11 18h2"></path></svg></span><span style="display: flex; flex-direction: column; gap: 8px"><h3 style="font-size: 19px; font-weight: 700; color: var(--ink)">Fast &amp; mobile-first</h3><p style="font-size: 16px">Built to load quickly on phones, where many patients first find and compare clinics.</p></span></div>
<div style="display: flex; gap: 20px; padding: 30px; border-radius: 24px; border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></span><span style="display: flex; flex-direction: column; gap: 8px"><h3 style="font-size: 19px; font-weight: 700; color: var(--ink)">SEO-ready foundations</h3><p style="font-size: 16px">Clean structure, metadata, schema and local signals in place from launch day.</p></span></div>
<div style="display: flex; gap: 20px; padding: 30px; border-radius: 24px; border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--blue); display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6Z"></path><path d="m9 12 2 2 4-4"></path></svg></span><span style="display: flex; flex-direction: column; gap: 8px"><h3 style="font-size: 19px; font-weight: 700; color: var(--ink)">Secure by default</h3><p style="font-size: 16px">SSL, protected forms and best-practice setup, so patient enquiries stay safe.</p></span></div>
</div>
</div>
</section>

<!-- ============ BUILT FOR CLINICS (SplitFeature) ============ -->
<section style="background: var(--tint)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: clamp(48px, 6vw, 88px); align-items: center">
<!-- Two real clinic websites -->
<div style="position: relative; display: flex; flex-direction: column; gap: 0; padding: 20px 0">
<div style="position: relative; width: 82%; z-index: 1">
<div style="background: #fff; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 34px 60px -30px rgba(13,24,56,0.5)">
<div style="display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #F1F3F8"><span style="width: 8px; height: 8px; border-radius: 50%; background: #FF8A80"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #FFD166"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #7BD88F"></span><span style="margin-left: 8px; flex: 1; max-width: 240px; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12px; color: #646B88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">coastalluxeaesthetics.com.au</span></div>
<img src="/images/cla-desk.webp" alt="Coastal Luxe Aesthetics website" style="display: block; width: 100%; height: auto" loading="lazy" decoding="async">
</div>
<span style="position: absolute; top: -14px; left: 18px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #8A4B36; background: #F8ECE7; border-radius: 999px; padding: 5px 12px; box-shadow: 0 10px 20px -12px rgba(13,24,56,0.4)">Aesthetic clinic</span>
</div>
<div style="position: relative; width: 82%; margin: -12% 0 0 auto; z-index: 2">
<div style="background: #fff; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 34px 60px -30px rgba(13,24,56,0.5)">
<div style="display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #F1F3F8"><span style="width: 8px; height: 8px; border-radius: 50%; background: #FF8A80"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #FFD166"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #7BD88F"></span><span style="margin-left: 8px; flex: 1; max-width: 240px; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 12px; color: #646B88; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">millenniumsmilesdc.com</span></div>
<img src="/images/mil-desk.webp" alt="Millennium Smiles Dental Center website" style="display: block; width: 100%; height: auto" loading="lazy" decoding="async">
</div>
<span style="position: absolute; top: -14px; left: 18px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #0B6770; background: #E3F5F6; border-radius: 999px; padding: 5px 12px; box-shadow: 0 10px 20px -12px rgba(13,24,56,0.4)">Dental clinic</span>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">Built for clinics</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink); text-wrap: balance">Designed around how patients choose a clinic</h2>
<p style="text-wrap: pretty">Patients compare results, people and convenience before they book. Your site answers those questions quickly and makes the next step obvious.</p>
<ul style="list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 14px 24px; font-size: 16px; font-weight: 600; color: var(--ink); width: 100%">
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Before-and-after galleries</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Practitioner profiles</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Treatment FAQs</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Reviews and trust signals</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Location and map pages</li>
<li style="display: flex; gap: 10px; align-items: flex-start"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3D66E4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="m5 12 5 5L20 7"></path></svg>Click-to-call on every page</li>
</ul>
<a class="btn btn-cta" href="/contact/" style="margin-top: 12px">Book a Free Clinic Growth Audit</a>
</div>
</div>
</section>

<!-- ============ PROCESS (ProcessSteps) ============ -->
<section style="background: #fff">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; max-width: 720px; margin: 0 auto">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">How a website project runs</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink); text-wrap: balance">From first call to fully booked</h2>
</div>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 24px">
<li style="display: flex; flex-direction: column; gap: 14px; padding: 32px; border-radius: 28px; background: var(--tint2); border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 800; font-size: 17px; display: flex; align-items: center; justify-content: center">01</span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Discovery &amp; audit</h3><p style="font-size: 16px">We learn your treatments, patients and goals, and review what your current site is missing.</p></li>
<li style="display: flex; flex-direction: column; gap: 14px; padding: 32px; border-radius: 28px; background: var(--tint2); border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 800; font-size: 17px; display: flex; align-items: center; justify-content: center">02</span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Sitemap &amp; design</h3><p style="font-size: 16px">A page plan built for search, then a design that matches the feel of your clinic.</p></li>
<li style="display: flex; flex-direction: column; gap: 14px; padding: 32px; border-radius: 28px; background: var(--tint2); border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 800; font-size: 17px; display: flex; align-items: center; justify-content: center">03</span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Build &amp; content</h3><p style="font-size: 16px">We build a fast, secure site, set up forms and tracking, and get every page ready to rank.</p></li>
<li style="display: flex; flex-direction: column; gap: 14px; padding: 32px; border-radius: 28px; background: var(--tint2); border: 1px solid var(--line)"><span style="width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: var(--ink); font-weight: 800; font-size: 17px; display: flex; align-items: center; justify-content: center">04</span><h3 style="font-size: 21px; font-weight: 700; color: var(--ink); margin-top: 6px">Launch &amp; grow</h3><p style="font-size: 16px">We launch, monitor enquiries and keep improving, with SEO and ads ready to plug in.</p></li>
</ol>
</div>
</section>

<!-- ============ RECENT WEBSITES (PortfolioCard ×3) ============ -->
<section style="background: var(--tint)">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(72px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px">
<p style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue)">Recent websites</p>
<h2 style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 800; color: var(--ink)">Websites we've built</h2>
</div>
<a class="btn btn-ghost" href="/portfolio/">View Our Work</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 24px">
<a class="card" href="/case-studies/coastal-luxe-aesthetics/" style="background: #fff; border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; color: inherit">
<div style="position: relative; aspect-ratio: 4 / 3; background: #F3ECE4; padding: 32px 32px 0; display: flex; align-items: flex-end">
<div style="width: 84%; background: #fff; border-radius: 12px 12px 0 0; overflow: hidden; box-shadow: 0 20px 40px -24px rgba(60,40,20,0.5)">
<div style="display: flex; gap: 5px; padding: 8px 10px; background: #F7F2EC"><span style="width: 7px; height: 7px; border-radius: 50%; background: #E3D6C8"></span><span style="width: 7px; height: 7px; border-radius: 50%; background: #E3D6C8"></span><span style="width: 7px; height: 7px; border-radius: 50%; background: #E3D6C8"></span></div>
<img src="/images/cla-desk.webp" alt="Coastal Luxe Aesthetics website" style="display: block; width: 100%; height: auto" loading="lazy" decoding="async">
</div>
<div style="position: absolute; right: 6%; bottom: 0; width: 24%; background: #1A2036; border-radius: 16px 16px 0 0; padding: 5px 5px 0"><img src="/images/cla-photo.webp" alt="" style="display: block; width: 100%; aspect-ratio: 9 / 14; object-fit: cover; border-radius: 12px 12px 0 0" loading="lazy" decoding="async"></div>
